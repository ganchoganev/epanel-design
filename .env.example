# Copy to .env next to docker-compose.yml.
# Host nginx (80/443) proxies epanel-build.com here. Do not bind 80/443 in Docker.
HTTP_PORT=8090
APP_URL=https://epanel-build.com
APP_KEY=

DB_DATABASE=eti_panel
DB_USERNAME=eti
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Каталогът, 2D чертежите и снимките от ETICAD са вътре в контейнера.
# Не се инсталира ETICAD на сървъра.

# Празно, докато не се попълни ключът. Четенето на схеми минава през Claude.
CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
CLAUDE_MODEL=claude-haiku-4-5

ADMIN_EMAIL=admin@epanel-build.com
ADMIN_PASSWORD=смени-тази-парола
ADMIN_NAME=Администратор
